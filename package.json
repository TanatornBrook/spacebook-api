{
  "name": "spacebook-api",
  "version": "1.0.0",
  "description": "SpaceBook - a campus study space booking API used as the project for the SIT223/SIT753 Jenkins DevOps pipeline",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build": "node scripts/build.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:ci": "jest --runInBand --ci --coverage --reporters=default --reporters=jest-junit",
    "lint": "eslint src tests"
  },
  "keywords": [
    "devops",
    "jenkins",
    "express",
    "booking"
  ],
  "author": "Tanatorn Rungsriwattana",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^6.3.4"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
